# Preencha e salve como .env (nunca commitado, ver .gitignore).

# Connection string do Postgres (Neon) que hospeda o schema pgl_auth.
NEON_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segredo usado pela API (api/login.py) para assinar os tokens JWT dos alunos.
# Gere um novo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="troque-por-um-segredo-aleatorio"

# URL pública da API de login depois do deploy no Vercel.
PGL_AUTH_API_URL="https://pgl-auth.vercel.app/api/login"
